<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/taskCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Status Indicator Bar -->
        <View
            android:id="@+id/statusBar"
            android:layout_width="4dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Task Icon Container -->
        <View
            android:id="@+id/taskIconBackground"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"

            app:layout_constraintStart_toEndOf="@id/statusBar"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/taskIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"


            app:layout_constraintBottom_toBottomOf="@id/taskIconBackground"
            app:layout_constraintEnd_toEndOf="@id/taskIconBackground"
            app:layout_constraintStart_toStartOf="@id/taskIconBackground"
            app:layout_constraintTop_toTopOf="@id/taskIconBackground" />

        <!-- Task Title -->
        <TextView
            android:id="@+id/taskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/taskIconBackground"
            app:layout_constraintTop_toTopOf="@id/taskIconBackground"
            tools:text="Complete Push-Ups" />

        <!-- Task Status Badge -->
        <TextView
            android:id="@+id/taskStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"

            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textAllCaps="true"
            android:textColor="@color/state_success"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/taskTitle"
            app:layout_constraintTop_toBottomOf="@id/taskTitle"
            tools:text="PENDING" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/app_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/taskIconBackground"
            app:layout_constraintTop_toBottomOf="@id/taskStatus" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/taskIconBackground"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/yesButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:text="@string/status_yes"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/button_primary"

                app:cornerRadius="10dp"
                app:elevation="0dp"

                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_on_primary"
                app:rippleColor="@color/app_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/noButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:text="@string/status_no"
                android:textAllCaps="false"
                android:textColor="@color/button_destructive_text"
                android:textSize="14sp"
                app:backgroundTint="@color/button_destructive_bg"

                app:cornerRadius="10dp"
                app:elevation="0dp"

                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/button_destructive_text"
                app:rippleColor="@color/app_border"
                app:strokeColor="@color/button_destructive_text"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>